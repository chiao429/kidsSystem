# Google service account（試算表需「共用」給這個 email，權限：編輯者）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# 主資料試算表（家庭、成員、帳號、活動）
GOOGLE_MASTER_SHEET_ID=
# 登入 cookie 簽章用，至少 16 字元；同一組帳號要跨系統使用時各 app 設一樣的值
AUTH_SECRET=
# 帳號分頁還沒有 admin 時，可用帳號 admin + 這組密碼登入後台做初始設定
ADMIN_BOOTSTRAP_PASSWORD=
# 系統之間的連結（只用於頁面上的超連結，不做 API 呼叫）
NEXT_PUBLIC_REGISTRATION_URL=http://localhost:3001
NEXT_PUBLIC_CHECKIN_URL=http://localhost:3002
# 本機開發：設定後改用 JSON 檔模擬試算表（不需 Google 憑證），所有 app 指向同一個目錄
# SHEETS_LOCAL_DIR=../../.local-sheets
