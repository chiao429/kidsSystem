# Google service account（試算表需「共用」給這個 email，權限：編輯者）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# 主資料試算表（家庭、成員、帳號、活動）
GOOGLE_MASTER_SHEET_ID=
# 登入 cookie 簽章用，至少 16 字元；同一組帳號要跨系統使用時各 app 設一樣的值
AUTH_SECRET=
# 帳號分頁還沒有 admin 時，可用帳號 admin + 這組密碼登入後台做初始設定
ADMIN_BOOTSTRAP_PASSWORD=
# 系統之間的連結（只用於頁面上的超連結與 QR，不做 API 呼叫）；統一入口下為 <入口>、<入口>/checkin
NEXT_PUBLIC_REGISTRATION_URL=http://localhost:3001
NEXT_PUBLIC_CHECKIN_URL=http://localhost:3001/checkin
# 本機開發：設定後改用 JSON 檔模擬試算表（不需 Google 憑證），所有 app 指向同一個目錄
# SHEETS_LOCAL_DIR=../../.local-sheets
# 資料來源：mongo = MongoDB 為正式資料、Google Sheet 為鏡像；未設定或 sheets = 直接讀寫 Google Sheets（或 SHEETS_LOCAL_DIR）
DATA_BACKEND=sheets
# MongoDB（DATA_BACKEND=mongo 時必填；五個 app 指向同一個 database）
MONGODB_URI=
MONGODB_DB=kids
# 正式切換期間設為 1：所有寫入回傳「系統維護中」
# READ_ONLY=1
# 統一入口網址（例如 https://kids.example.org；本機 http://localhost:3001）
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# 經由統一入口送出的 Server Action 允許來源（主機名稱，可逗號分隔）
SITE_HOST=localhost:3001
