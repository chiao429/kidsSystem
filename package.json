{
  "name": "easyevent",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:registration": "npm run dev -w @easyevent/registration",
    "dev:checkin": "npm run dev -w @easyevent/checkin",
    "dev:rollcall": "npm run dev -w @easyevent/rollcall",
    "dev:admin": "npm run dev -w @easyevent/admin",
    "dev:data-tools": "npm run dev -w @easyevent/data-tools",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  }
}
